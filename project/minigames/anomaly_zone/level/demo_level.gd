class_name DemoLevel
extends ZoneLevel
## Демо-уровень «Зона»: семь секций слева направо. Каждая показывает одну идею механики.
## Уровень собирается кодом, чтобы все координаты были в одном месте и легко правились.
##
##  0. Полигон движения — подкат, зацеп за край, отскоки в шахте, лестница, спуск под перекат,
##     тайник за разрывом (только прыжком из подката).
##  1. Разминка — бег, прыжки, стенка, яма.
##  2. Жарка — Капля превращает огонь в пар, пар поднимает на уступ над стеной.
##  3. Коридор Электр — разряжай болтами; с Каплей Электры злее (её можно положить и забрать
##     позже). Батарейка в конце копит разряды; яму за коридором берёт только рывок с зарядом.
##  4. Трамплин — уступ достижим только с Пружиной (усиление и есть решение).
##  5. Воронка под пропастью — с Грави она отталкивает снизу и помогает перелететь.
##  6. Холодец, Электра и Жарка — Медуза (желе), Пламя (сушит; Жарка досушит насовсем)
##     или Батарейка (ток уходит в заряд).
##  7. Огненный смерч — Воронка закручивает огонь Жарки над ямой. Финиш.


## Лаз к тайнику на башне: низкий потолок срезает прыжок, и разрыв решает скорость —
## обычным прыжком (280 px/с) не допрыгнуть, прыжком из подката (400 px/с) — да.
const STASH_GAP := 170.0
const TUNNEL_H := 70.0
## Пропасть Воронки (от 6280): подобрана ботом под 10–14 удач из 18 с Грави и рывком.
const VORONKA_PIT := 780.0
## Тайник ниже края башни: полёт дольше — разница скоростей заметнее.
const STASH_DROP := 140.0


func _build() -> void:
	bounds = Rect2(-3300.0, -300.0, 13300.0, 1300.0)
	_training()
	_warmup()
	_zharka()
	_electra_corridor()
	_trampolin()
	_voronka()
	_kholodets()
	_fire_tornado()
	_finish_at(9500.0)


# --- Секции ----------------------------------------------------------------

func _training() -> void:
	_checkpoint(-3150.0)
	_sign(-3060.0, "A/D или ←/→ — бег.
Пробел — прыжок (держите — выше)", 300.0)
	# Подкат: плита со щелью 30 px до самого верха — перепрыгнуть нельзя.
	_sign(-2740.0, "S на бегу — подкат.
Под плитой щель 30 px", 220.0)
	_plat(-2560.0, -300.0, 80.0, FLOOR_Y - 30.0 + 300.0)
	# Уступ 150 px: прыжком (~108) не достать, зацепом за край — да (до ~168).
	_sign(-2250.0, "Прыгните к уступу — зацепитесь за край.
W или к стене — подтянуться, S — отпустить", 340.0)
	_plat(-2000.0, FLOOR_Y - 150.0, 200.0, 150.0)
	# Шахта 100 px: висячая стена и блок 220 px — наверх только отскоками от стен.
	_sign(-1600.0, "У стены в падении — скольжение.
Пробел — отскок, не больше двух подряд", 340.0)
	_plat(-1400.0, 300.0, 40.0, 240.0)
	_plat(-1260.0, FLOOR_Y - 220.0, 200.0, 220.0)
	# Башня 400 px: наверх по лестнице, вниз — спуск под перекат; с башни — тайник за разрывом.
	_checkpoint(-900.0)
	_sign(-830.0, "Лестница: W / S, Пробел — спрыгнуть.
Наверху лаз: тайник — прыжком из подката.
Вниз 400 px: S перед касанием — перекат", 360.0)
	_ladder(-630.0, 200.0, FLOOR_Y)
	_plat(-600.0, 200.0, 300.0, FLOOR_Y - 200.0)
	var stash_x := -300.0 + STASH_GAP
	_plat(-440.0, 200.0 - TUNNEL_H - 40.0, stash_x + 110.0 + 440.0, 40.0)  # потолок лаза
	var stash := _plat(stash_x, 200.0 + STASH_DROP, 110.0, 20.0)
	stash.no_grab = true  # гнилой край: зацепом не взять
	_pickup(&"aptechka", stash_x + 70.0, 200.0 + STASH_DROP)


func _warmup() -> void:
	_floor(-3300.0, 760.0)
	_floor(920.0, 1640.0)  # яма 160 px — обычный прыжок
	# Яма 180 px (1640..1820): прыжок с разбега ~210 px, запас 30.
	_plat(300.0, 520.0, 150.0, 20.0)
	_plat(520.0, 440.0, 150.0, 20.0, true)
	_plat(1180.0, 520.0, 40.0, 80.0)  # стенка
	_checkpoint(80.0)
	_sign(60.0, "S+Пробел — спрыгнуть с платформы с пунктиром", 400.0)
	_sign(1440.0, "Яма — с разбега. Держите Пробел у вершины прыжка:\nтам вы зависаете чуть дольше", 340.0)


func _zharka() -> void:
	_floor(1820.0, 2100.0)
	_plat(2200.0, FLOOR_Y, 200.0, 40.0)  # остров под огненным столбом
	_floor(2500.0, 4560.0)
	# Стена закрывает путь по земле; наверх — только по столбу пара (Капля превращает Жарку).
	# Уступ на 190 px над полом — выше досягаемости зацепа (~168), только паром.
	_plat(2520.0, 430.0, 40.0, FLOOR_Y - 430.0)
	_plat(2330.0, 410.0, 430.0, 20.0, true)
	_checkpoint(1840.0)
	_sign(1900.0, "F — болт: провоцирует Жарку.
Капля превращает огонь в пар — а пар поднимает", 360.0)
	_pickup(&"kaplya", 2040.0)
	var z := Zharka.new()
	z.size = Vector2(200.0, 260.0)
	_anomaly(z, Vector2(2300.0, FLOOR_Y))
	_pickup(&"aptechka", 2900.0)


func _electra_corridor() -> void:
	_checkpoint(3060.0)
	_sign(3100.0, "С Каплей Электры злее. Её можно положить (S+G)
и забрать потом — с Батарейкой Электры не бьют", 400.0)
	_plat(3180.0, 360.0, 1120.0, 110.0)  # потолок: сверху не перепрыгнуть
	for x in [3350.0, 3600.0, 3850.0, 4100.0]:
		_anomaly(Electra.new(), Vector2(x, FLOOR_Y - 40.0))
	_pickup(&"batareyka", 4380.0)
	_pickup(&"vspyshka", 4250.0)  # рождается в Электре: лежит у последней из них
	_sign(4420.0, "Батарейка копит разряды. Shift с зарядом —
рывок вдвое дальше. 4-й заряд — перегрузка!", 330.0)
	# Электра-«зарядка» у края ямы 370 px: без рывка (~215 px) её не перелететь; рывок даёт заряд Батарейки или Вспышка.
	_anomaly(Electra.new(), Vector2(4500.0, FLOOR_Y - 40.0))


func _trampolin() -> void:
	_floor(4930.0, 6280.0)
	_checkpoint(5240.0)
	_sign(5290.0, "Невидимые зоны проявляет болт. Артефакт можно
бросить (G): аура действует там, где он лежит", 330.0)
	# Боковая ниша с Пружиной — в стороне от основного пути.
	_plat(5460.0, 520.0, 110.0, 20.0, true)
	_plat(5590.0, 440.0, 110.0, 20.0, true)
	_pickup(&"pruzhina", 5645.0, 440.0)
	# Высокий уступ: достаётся только трамплином с Пружиной (×2).
	_plat(5130.0, 330.0, 970.0, 20.0, true)
	_plat(5930.0, 370.0, 40.0, FLOOR_Y - 370.0)  # стена, закрывающая путь по земле
	_anomaly(Trampolin.new(), Vector2(5780.0, FLOOR_Y - 20.0))
	_pickup(&"gravi", 6070.0, 330.0)


func _voronka() -> void:
	_checkpoint(6080.0)
	_sign(6150.0, "Tab — инвентарь. На поясе только 3 слота:
выбирайте артефакты под задачу", 360.0)
	# Пропасть VORONKA_PIT px от 6280: без Грави не перелететь. Воронка под её серединой.
	var far := 6280.0 + VORONKA_PIT
	var v := Voronka.new()
	v.radius = 460.0
	v.pull = 5000.0
	_anomaly(v, Vector2(6280.0 + VORONKA_PIT * 0.5, 700.0))
	_floor(far, 8880.0)
	_pickup(&"aptechka", far + 60.0)


func _kholodets() -> void:
	_checkpoint(6280.0 + VORONKA_PIT + 110.0)
	_pickup(&"plamya", 7260.0)
	_sign(7380.0, "Холодец жжёт, а Электра в нём бьёт током всю лужу.
Медуза — желе, Пламя — сушит, Батарейка — ловит разряды", 480.0)
	var k := Kholodets.new()
	k.size = Vector2(800.0, 18.0)
	k.dps = 8.0
	_anomaly(k, Vector2(7920.0, FLOOR_Y))
	_pickup(&"meduza", 7560.0)  # лежит на краю лужи — риск ради награды
	_anomaly(Electra.new(), Vector2(7920.0, FLOOR_Y - 40.0))
	# Жарка за лужей: обычная до лужи не дотягивается, с Пламенем (×1.8) досушит её насовсем.
	var z := Zharka.new()
	z.size = Vector2(110.0, 220.0)
	_anomaly(z, Vector2(8435.0, FLOOR_Y))


func _fire_tornado() -> void:
	_checkpoint(8650.0)
	_sign(8640.0, "Воронка закручивает огонь Жарки в смерч.\nПрыгайте, когда стихнет,\nили превратите Жарку в пар", 280.0)
	var z := Zharka.new()
	z.size = Vector2(60.0, 200.0)
	z.periodic = true
	z.period = 2.5
	_anomaly(z, Vector2(8790.0, FLOOR_Y))
	# Яма 300 px (8880..9180) — с рывком; ядро Воронки над ней.
	var v := Voronka.new()
	v.radius = 280.0
	v.pull = 2500.0
	v.fire_dps = 45.0
	_anomaly(v, Vector2(9030.0, 430.0))
	_floor(9180.0, 10000.0)
